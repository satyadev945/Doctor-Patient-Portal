<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>Doctor-Patient-Portal</display-name>

  <!--
    ================================================================
    Spring Session – cloud-readiness fix cr-java-0065
    ================================================================
    Bootstrap the Spring application context so that
    RedisSessionConfig (@EnableRedisHttpSession) is loaded.
    The AnnotationConfigWebApplicationContext scans the
    com.hms.config package for @Configuration classes.
    ================================================================
  -->
  <context-param>
    <param-name>contextClass</param-name>
    <param-value>
      org.springframework.web.context.support.AnnotationConfigWebApplicationContext
    </param-value>
  </context-param>
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>com.hms.config</param-value>
  </context-param>

  <listener>
    <listener-class>
      org.springframework.web.context.ContextLoaderListener
    </listener-class>
  </listener>

  <!--
    ================================================================
    Spring Session filter – MUST be declared before any other filter
    so that every request uses the Redis-backed HttpSession.
    ================================================================
  -->
  <filter>
    <filter-name>springSessionRepositoryFilter</filter-name>
    <filter-class>org.springframework.web.filter.DelegatingFilterProxy</filter-class>
    <async-supported>true</async-supported>
  </filter>
  <filter-mapping>
    <filter-name>springSessionRepositoryFilter</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
    <dispatcher>ERROR</dispatcher>
  </filter-mapping>

  <!-- ============================================================
       Existing servlet declarations (unchanged)
       ============================================================ -->
  <servlet>
    <servlet-name>myuserServlet</servlet-name>
    <display-name>myuserServlet</display-name>
    <description></description>
    <servlet-class>com.hms.user.servlet.myuserServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>MyNewServlet</servlet-name>
    <display-name>MyNewServlet</display-name>
    <description></description>
    <servlet-class>com.hms.user.servlet.MyNewServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>myuserServlet</servlet-name>
    <url-pattern>/myuserServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>MyNewServlet</servlet-name>
    <url-pattern>/MyNewServletRegisterUser</url-pattern>
  </servlet-mapping>

</web-app>
